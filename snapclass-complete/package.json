{
  "name": "snapclass-web",
  "version": "1.0.0",
  "description": "SnapClass – AI Attendance System (Web Frontend + Node Backend)",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "ai": "uvicorn ai_server.main:app --host 0.0.0.0 --port 8000 --reload",
    "dev:all": "concurrently \"npm run dev\" \"npm run ai\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  }
}
